MOE_ROUTE gen_match=1 gen_crc=0xe5ead011
MOE_RR route_calls=200 copies=200 copy_bytes=6982400 copy_us=115851 counts=100,100
MOE_RR us=168884 forwards=40 per_forward_us=4222
