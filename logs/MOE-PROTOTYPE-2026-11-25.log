MOE_MODEL match=1 active_crc=0xb2f5d2bd psram_free=6695776
MOE_BASE gen_match=1 gen_crc=0xe5ead011 logit_crc=0x4a4a3c07 us=50656 forwards=40
MOE_BIND rc=0 arena w1=860x64/64 w2=320x172/176 w3=860x64/64 slice=34912 all_layers=174560 psram_free=6695776
